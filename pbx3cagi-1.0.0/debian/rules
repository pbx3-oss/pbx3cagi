#!/usr/bin/make -f
# Sailhpe model (Architecture: all): no compile in debuild.
# Required: usr/share/asterisk/agi-bin/pbx3cagi.arm64
# Optional:  usr/share/asterisk/agi-bin/pbx3cagi.amd64 (plug in when built)

PACKAGE=$(shell dh_listpackages)
AGI_BIN=usr/share/asterisk/agi-bin

build:
	dh_testdir

clean:
	dh_testdir
	dh_testroot
	dh_clean -d
	rm -rf usr

binary-indep: build

binary-arch: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	dh_installdocs
	dh_installchangelogs

	@test -f $(AGI_BIN)/pbx3cagi.arm64 || (echo "ERROR: missing $(AGI_BIN)/pbx3cagi.arm64 — run scripts/seed-deb-binaries.sh before debuild" >&2; exit 1)

	mkdir -p debian/$(PACKAGE)
	cp -a usr debian/$(PACKAGE)/

	dh_compress
	dh_makeshlibs
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary
