#!/usr/bin/make -f
# Same packaging model as sailhpe (SARK 6.0.0): no compile in rules.
# Stage pre-built binaries under usr/ at package root (sibling to debian/), then debuild.
#   pbx3cagi-1.0.0/usr/share/asterisk/agi-bin/pbx3cagi.amd64
#   pbx3cagi-1.0.0/usr/share/asterisk/agi-bin/pbx3cagi.arm64

PACKAGE=$(shell dh_listpackages)

build:
	dh_testdir

clean:
	dh_testdir
	dh_testroot
	dh_clean -d

binary-indep: build

binary-arch: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	dh_installdocs
	dh_installchangelogs

# Copy the package's files (usr/, etc.) — not debian/
	find . -maxdepth 1 -mindepth 1 -not -name debian -print0 | \
		xargs -0 -r -i cp -a {} debian/$(PACKAGE)

	dh_compress
	dh_makeshlibs
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary
