#!/usr/bin/make -f
# Sailhpe model (Architecture: all): no compile in debuild.
# Required: prebuilt/agi-bin/pbx3cagi.arm64
# Optional: prebuilt/agi-bin/pbx3cagi.amd64

PACKAGE=$(shell dh_listpackages)
PREBUILT=prebuilt/agi-bin
AGI_DEST=usr/share/asterisk/agi-bin

build:
	dh_testdir

clean:
	dh_testdir
	dh_testroot
	dh_clean -d

binary-indep: build

binary-arch: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	dh_installdocs
	dh_installchangelogs

	@test -f $(PREBUILT)/pbx3cagi.arm64 || (echo "ERROR: missing $(PREBUILT)/pbx3cagi.arm64 — run scripts/seed-deb-binaries.sh before debuild" >&2; exit 1)

	mkdir -p debian/$(PACKAGE)/$(AGI_DEST)
	cp -a $(PREBUILT)/pbx3cagi.arm64 debian/$(PACKAGE)/$(AGI_DEST)/
	@if [ -f $(PREBUILT)/pbx3cagi.amd64 ]; then cp -a $(PREBUILT)/pbx3cagi.amd64 debian/$(PACKAGE)/$(AGI_DEST)/; fi

	dh_compress
	dh_makeshlibs
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary
