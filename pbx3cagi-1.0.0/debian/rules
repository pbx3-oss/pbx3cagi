#!/usr/bin/make -f

PACKAGE=$(shell dh_listpackages)
ARCH := $(shell dpkg-architecture -qDEB_HOST_ARCH 2>/dev/null)

build:
	dh_testdir
	$(MAKE) -C csource

clean:
	dh_testdir
	dh_testroot
	$(MAKE) -C csource clean
	dh_clean -d

binary-indep: build

binary-arch: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	# Install architecture-specific binary; postinst will symlink pbx3cagi -> pbx3cagi.$(ARCH)
	install -d debian/$(PACKAGE)/usr/share/asterisk/agi-bin
	install -m 755 csource/pbx3cagi debian/$(PACKAGE)/usr/share/asterisk/agi-bin/pbx3cagi.$(ARCH)

	dh_installdocs
	dh_installchangelogs

	dh_compress
	dh_makeshlibs
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

binary: binary-indep binary-arch
.PHONY: build clean binary-indep binary-arch binary
